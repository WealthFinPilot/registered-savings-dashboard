/// Table de dates du modèle (vue rapport.calendrier) : un jour par ligne, années complètes de la table Année. Axe des mois des visuels ; base du TWR mensuel de l'itération 4.
table Calendrier
	lineageTag: f486e59a-9ea7-4b65-b441-c741fa4049e8
	dataCategory: Time

	/// Jour ; clé de la table de dates
	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: ea23e490-f1d7-419e-a9d5-4af569a17747
		summarizeBy: none
		sourceColumn: date

		annotation UnderlyingDateTimeDataType = Date

	/// Année civile du jour : relie le calendrier à la table Année (filtre commun avec les droits)
	column Année
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: d9466e78-c97b-41a8-8e81-76d7f392a993
		summarizeBy: none
		sourceColumn: annee

	/// Premier jour du mois : axe des visuels mensuels
	column Mois
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 1ebdcc0c-a2fb-4c26-97f1-77d3c1cabce5
		summarizeBy: none
		sourceColumn: mois

		annotation UnderlyingDateTimeDataType = Date

	/// Mois antérieur ou égal au mois de la date d'arrêté (R15) : les KPI « cotisé cumulé » s'arrêtent au dernier mois écoulé
	column 'Mois écoulé'
		dataType: boolean
		isHidden
		lineageTag: c6484435-4b00-40c2-94c4-9645903a2604
		summarizeBy: none
		sourceColumn: mois_ecoule

	partition Calendrier = m
		mode: import
		source =
				let
				    // Vue rapport.calendrier : un jour par ligne, générée en SQL
				    #"Vue calendrier lue" =
				        // Figée : vue rapport.calendrier de finance_ve01, données fictives, 2191 lignes (scripts/figer.py)
				        let
				            Lignes = Json.Document(Binary.Decompress(Binary.FromText(
				                "" &
				                "",
				                BinaryEncoding.Base64), Compression.Deflate)),
				            Brute = Table.FromRows(Lignes, {"date", "annee", "mois", "numero_mois", "trimestre", "mois_ecoule"}),
				            Dates = Table.TransformColumns(Brute, {{"date", each Date.FromText(_, [Format = "yyyy-MM-dd", Culture = "en-US"]), type nullable date}, {"mois", each Date.FromText(_, [Format = "yyyy-MM-dd", Culture = "en-US"]), type nullable date}}),
				            Typée = Table.TransformColumnTypes(Dates, {{"annee", Int64.Type}, {"numero_mois", Int64.Type}, {"trimestre", type text}, {"mois_ecoule", type logical}})
				        in
				            Typée,
				    // Colonnes du rapport seulement : numero_mois et trimestre restent en base
				    #"Colonnes retenues" = Table.SelectColumns(#"Vue calendrier lue", {"date", "annee", "mois", "mois_ecoule"}),
				    // Types explicites : dates sans heure, entiers, booléen
				    #"Types fixés" = Table.TransformColumnTypes(#"Colonnes retenues", {{"date", type date}, {"annee", Int64.Type}, {"mois", type date}, {"mois_ecoule", type logical}})
				in
				    #"Types fixés"

