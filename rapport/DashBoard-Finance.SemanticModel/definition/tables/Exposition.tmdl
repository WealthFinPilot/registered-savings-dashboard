/// Exposition par transparence au dernier point de chaque compte (vue rapport.exposition, règles S1 à S5 de docs/regles-strategie.md) : VM × poids publié par la Société 1, par axe (classe d'actif, style, géographie) et par catégorie. La somme d'un axe égale la VM du compte.
table Exposition
	lineageTag: b5bf4ef8-782c-46bc-b0bc-20e11ede5f00

	column compte_alias
		dataType: string
		isHidden
		lineageTag: 05e4b46a-18af-4870-9a32-e20a04f59683
		summarizeBy: none
		sourceColumn: compte_alias

	/// Classe d'actif (S3), Style (S5) ou Géographie (S4) : chaque visuel n'en montre qu'un
	column Axe
		dataType: string
		lineageTag: 3f3c0676-d30e-4eed-8fb0-14c6a3bbbaea
		summarizeBy: none
		sourceColumn: axe

	column ordre
		dataType: int64
		isHidden
		lineageTag: bb925ad6-6a7a-4ce3-a5db-b2b9eafc3c53
		summarizeBy: none
		sourceColumn: ordre

	/// Catégorie de l'axe, triée par ordre (un seul ordre par libellé : « Revenu fixe » se trie de même en classe et en style)
	column Catégorie
		dataType: string
		lineageTag: 4d8fee0d-18b8-4c6c-bd6c-db00a76340e5
		summarizeBy: none
		sourceColumn: categorie
		sortByColumn: ordre

	/// VM × poids, en dollars, non arrondi (nombre décimal : le poids porte plus de quatre décimales)
	column montant
		dataType: double
		isHidden
		formatString: #,##0 $
		lineageTag: 42b65522-7833-4e27-b940-33bc8e653de9
		summarizeBy: none
		sourceColumn: montant

	/// Fonds (S7) : code de l'option FA, ou code détenu sans profil ; clé vers la table Fonds
	column code_fa
		dataType: string
		isHidden
		lineageTag: de041647-e34a-403b-8669-78b566143e60
		summarizeBy: none
		sourceColumn: code_fa

	partition Exposition = m
		mode: import
		source =
				let
				    // Vue rapport.exposition : compte × point × fonds × axe × catégorie, tous les points
				    #"Vue exposition lue" =
				        // Figée : vue rapport.exposition de finance_ve01, données fictives, 7004 lignes (scripts/figer.py)
				        let
				            Lignes = Json.Document(Binary.Decompress(Binary.FromText(
				                "" &
				                "" &
				                "" &
				                "" &
				                "" &
				                "" &
				                "" &
				                "" &
				                "" &
				                "" &
				                "" &
				                "" &
				                "" &
				                "" &
				                "" &
				                "" &
				                "" &
				                "" &
				                "" &
				                "",
				                BinaryEncoding.Base64), Compression.Deflate)),
				            Brute = Table.FromRows(Lignes, {"compte_alias", "mois", "date_point", "dernier", "code_fa", "axe", "categorie", "ordre", "montant"}),
				            Dates = Table.TransformColumns(Brute, {{"mois", each Date.FromText(_, [Format = "yyyy-MM-dd", Culture = "en-US"]), type nullable date}, {"date_point", each Date.FromText(_, [Format = "yyyy-MM-dd", Culture = "en-US"]), type nullable date}}),
				            Typée = Table.TransformColumnTypes(Dates, {{"compte_alias", type text}, {"dernier", type logical}, {"code_fa", type text}, {"axe", type text}, {"categorie", type text}, {"ordre", Int64.Type}, {"montant", type number}})
				        in
				            Typée,
				    // Dernier point de chaque compte seulement : les pages montrent la stratégie actuelle
				    #"Dernier point" = Table.SelectRows(#"Vue exposition lue", each [dernier] = true),
				    // Colonnes du rapport seulement : le régime et la société viennent de la table Compte, le fonds de la table Fonds (S7)
				    #"Colonnes retenues" = Table.SelectColumns(#"Dernier point", {"compte_alias", "code_fa", "axe", "categorie", "ordre", "montant"}),
				    // Types explicites ; montant en nombre décimal, sans l'arrondi à quatre décimales du décimal fixe
				    #"Types fixés" = Table.TransformColumnTypes(#"Colonnes retenues", {{"compte_alias", type text}, {"code_fa", type text}, {"axe", type text}, {"categorie", type text}, {"ordre", Int64.Type}, {"montant", type number}})
				in
				    #"Types fixés"

	annotation PBI_ResultType = Table

