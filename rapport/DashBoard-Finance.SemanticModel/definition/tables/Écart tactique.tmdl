				            Brute = Table.FromRows(Lignes, {"compte_alias", "mois", "date_point", "dernier", "code_fa", "categorie", "ordre", "actuel", "strategique", "ecart"}),
				            Dates = Table.TransformColumns(Brute, {{"mois", each Date.FromText(_, [Format = "yyyy-MM-dd", Culture = "en-US"]), type nullable date}, {"date_point", each Date.FromText(_, [Format = "yyyy-MM-dd", Culture = "en-US"]), type nullable date}}),
				            Typée = Table.TransformColumnTypes(Dates, {{"compte_alias", type text}, {"dernier", type logical}, {"code_fa", type text}, {"categorie", type text}, {"ordre", Int64.Type}, {"actuel", type number}, {"strategique", type number}, {"ecart", type number}})
				        in
				            Typée,
				    // Dernier point de chaque compte seulement, comme Exposition
				    #"Dernier point" = Table.SelectRows(#"Vue écart lue", each [dernier] = true),
				    // Colonnes du rapport seulement : clés vers Compte et Fonds, classe, montants actuel et stratégique (l'écart se calcule en DAX)
