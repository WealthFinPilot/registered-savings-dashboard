	partition 'Détention RDRF' = m
		mode: import
		source =
				let
				    // Vue rapport.detention_rapport : compte × fonds au dernier point, avec le RDRF du fonds (S11, S12)
				    #"Vue lue" =
				        // Figée : vue rapport.detention_rapport de finance_ve01, données fictives, 21 lignes (scripts/figer.py)
				        let
				            Lignes = Json.Document(Binary.Decompress(Binary.FromText(
				                "",
				                BinaryEncoding.Base64), Compression.Deflate)),
				            Brute = Table.FromRows(Lignes, {"compte_alias", "regime", "code_fa", "vm", "avec_rdrf", "exercice", "rfo", "rotation", "part_revenus", "part_dividendes", "part_gains_capital", "part_remb_capital", "vm_rfo", "vm_rotation", "vm_nature"}),
				            Dates = Table.TransformColumns(Brute, {{"exercice", each Date.FromText(_, [Format = "yyyy-MM-dd", Culture = "en-US"]), type nullable date}}),
				            Typée = Table.TransformColumnTypes(Dates, {{"compte_alias", type text}, {"regime", type text}, {"code_fa", type text}, {"vm", type number}, {"avec_rdrf", type logical}, {"rfo", type number}, {"rotation", type number}, {"part_revenus", type number}, {"part_dividendes", type number}, {"part_gains_capital", type number}, {"part_remb_capital", type number}, {"vm_rfo", type number}, {"vm_rotation", type number}, {"vm_nature", type number}})
				        in
				            Typée,
				    // Colonnes du rapport seulement : clés vers Compte et Fonds, VM, valeurs du RDRF et VM qui les porte (S13)
				    #"Colonnes retenues" = Table.SelectColumns(#"Vue lue", {"compte_alias", "code_fa", "vm", "rfo", "rotation", "part_revenus", "part_dividendes", "part_gains_capital", "part_remb_capital", "vm_rfo", "vm_rotation", "vm_nature"}),
