	partition Détention = m
		mode: import
		source =
				let
				    // Vue rapport.detention : compte × point × fonds, tous les points
				    #"Vue détention lue" =
				        // Figée : vue rapport.detention de finance_ve01, données fictives, 795 lignes (scripts/figer.py)
				        let
				            Lignes = Json.Document(Binary.Decompress(Binary.FromText(
				                "" &
				                "" &
				                "" &
				                "",
				                BinaryEncoding.Base64), Compression.Deflate)),
				            Brute = Table.FromRows(Lignes, {"compte_alias", "mois", "date_point", "dernier", "code_fa", "risque", "valeur_marchande", "vm_rang", "vm_cotee"}),
				            Dates = Table.TransformColumns(Brute, {{"mois", each Date.FromText(_, [Format = "yyyy-MM-dd", Culture = "en-US"]), type nullable date}, {"date_point", each Date.FromText(_, [Format = "yyyy-MM-dd", Culture = "en-US"]), type nullable date}}),
				            Typée = Table.TransformColumnTypes(Dates, {{"compte_alias", type text}, {"dernier", type logical}, {"code_fa", type text}, {"risque", type text}, {"valeur_marchande", type number}, {"vm_rang", type number}, {"vm_cotee", type number}})
				        in
				            Typée,
				    // Dernier point de chaque compte seulement, comme Exposition
				    #"Dernier point" = Table.SelectRows(#"Vue détention lue", each [dernier] = true),
				    // Colonnes du rapport seulement : clés vers Compte, Fonds et Niveau de risque, et les trois montants
				    #"Colonnes retenues" = Table.SelectColumns(#"Dernier point", {"compte_alias", "code_fa", "risque", "valeur_marchande", "vm_rang", "vm_cotee"}),
				    // Types explicites ; montants en nombre décimal, comme Exposition
				    #"Types fixés" = Table.TransformColumnTypes(#"Colonnes retenues", {{"compte_alias", type text}, {"code_fa", type text}, {"risque", type text}, {"valeur_marchande", type number}, {"vm_rang", type number}, {"vm_cotee", type number}})
				in
				    #"Types fixés"

