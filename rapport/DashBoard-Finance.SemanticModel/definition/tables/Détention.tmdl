		isHidden
		lineageTag: e86c62b0-27dc-44b3-b0ae-55d935cecf01
		summarizeBy: none
		sourceColumn: code_fa

	/// Niveau de risque du profil applicable (S1, S8), « Non coté » sans profil
	column risque
