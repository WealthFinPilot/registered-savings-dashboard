/// Une ligne par compte, fonds et date de rendement (vue rapport.rendement_quotidien, règles P10 à P12 et P15 de docs/regles-performance.md) : VM à la clôture de la veille, rendement total du fonds et de son repère. Une ligne seulement si le compte détenait le fonds la veille.
table 'Rendement quotidien'
	lineageTag: 9cd336b6-0c99-4a26-a63c-cca16241a4bd

	column compte_alias
		dataType: string
		isHidden
		lineageTag: 0d19c16f-9b39-460c-9049-e3b0006c7aaf
		summarizeBy: none
		sourceColumn: compte_alias

	column code_fa
		dataType: string
		isHidden
		lineageTag: bd6917b5-7192-432e-ad18-50b2366839a2
		summarizeBy: none
		sourceColumn: code_fa

	/// Date du rendement : la seconde de deux dates de prix consécutives du fonds (P10, P11)
	column jour
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: ea86f298-59b0-4f59-9b57-5dc422ef8e4d
		summarizeBy: none
		sourceColumn: jour

		annotation UnderlyingDateTimeDataType = Date

	/// Date de prix précédente du fonds ; la première veille d'une fenêtre date un sommet égal à la valeur de départ (P14)
	column veille
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 41363773-f0cf-4c36-9e6a-daf0d5af2ae8
		summarizeBy: none
		sourceColumn: veille

		annotation UnderlyingDateTimeDataType = Date

	/// Parts à la clôture de la veille × prix de la veille, sans arrondi : poids du rendement (P12)
	column vm_veille
		dataType: double
		isHidden
		formatString: #,##0 $
		lineageTag: 5e172395-60b2-4294-8563-767127d46b50
		summarizeBy: none
		sourceColumn: vm_veille

	/// Rendement total du fonds : (prix + distribution par part) ÷ prix de la veille − 1 (P11)
	column rendement
		dataType: double
		isHidden
		lineageTag: 8794ed0f-7234-49a9-99cf-ba445549f317
		summarizeBy: none
		sourceColumn: rendement

	/// Rendement du composite de FNB du fonds, rééquilibré chaque jour (P15)
	column repere
		dataType: double
		isHidden
		lineageTag: b7681904-a46b-4741-822c-c73d757dcc22
		summarizeBy: none
		sourceColumn: repere

