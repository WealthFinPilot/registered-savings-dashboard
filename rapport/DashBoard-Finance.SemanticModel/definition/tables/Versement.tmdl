/// Un versement par ligne : achats PAC et ponctuels de tous les comptes, transferts entrants exclus (vue rapport.versement). Montant brut, avant déductions (hypothèse H1).
table Versement
	lineageTag: 75bd679a-899e-481e-8a3d-85eb383f3959

	column compte_alias
		dataType: string
		isHidden
		lineageTag: 2793379f-a425-4f25-a595-51df8930545c
		summarizeBy: none
		sourceColumn: compte_alias

	/// Date de négociation du versement
	column 'Date de négociation'
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: d41808c0-69a4-4cb4-82aa-3d6d359cd870
		summarizeBy: none
		sourceColumn: date_negociation

		annotation UnderlyingDateTimeDataType = Date

	/// PAC (versement systématique) ou ponctuel
	column Nature
		dataType: string
		lineageTag: a2c53741-5fca-48f2-8ee9-f215dc993def
		summarizeBy: none
		sourceColumn: nature

	column montant
		dataType: decimal
		isHidden
		formatString: #,##0 $
		lineageTag: 1758d29e-80fb-410d-bcfa-14483cfb059e
		summarizeBy: none
		sourceColumn: montant

	column annee
		dataType: int64
		isHidden
		lineageTag: 40d061cf-e5bd-40f9-8630-d8b26619f832
		summarizeBy: none
		sourceColumn: annee

	/// 60 premiers jours de l'année (borne R6 de ref.periode_reer) ou reste de l'année : seuls les versements REER des 60 premiers jours sont déductibles pour l'année précédente
	column Période
		dataType: string
		lineageTag: ad651b37-2a14-4a83-8512-5a0a486c2292
		summarizeBy: none
		sourceColumn: periode

	partition Versement = m
		mode: import
		source =
				let
				    // Vue rapport.versement : achats PAC et ponctuels, transferts entrants exclus
				    #"Vue versement lue" =
				        // Figée : vue rapport.versement de finance_ve01, données fictives, 717 lignes (scripts/figer.py)
				        let
				            Lignes = Json.Document(Binary.Decompress(Binary.FromText(
				                "" &
				                "",
				                BinaryEncoding.Base64), Compression.Deflate)),
				            Brute = Table.FromRows(Lignes, {"compte_alias", "regime", "societe", "date_negociation", "mois", "rang", "nature", "montant", "annee", "periode"}),
				            Dates = Table.TransformColumns(Brute, {{"date_negociation", each Date.FromText(_, [Format = "yyyy-MM-dd", Culture = "en-US"]), type nullable date}, {"mois", each Date.FromText(_, [Format = "yyyy-MM-dd", Culture = "en-US"]), type nullable date}}),
				            Typée = Table.TransformColumnTypes(Dates, {{"compte_alias", type text}, {"regime", type text}, {"societe", type text}, {"rang", Int64.Type}, {"nature", type text}, {"montant", type number}, {"annee", Int64.Type}, {"periode", type text}})
				        in
				            Typée,
				    // Colonnes du rapport seulement : le régime et la société viennent de la table Compte, le mois de la table Calendrier
				    #"Colonnes retenues" = Table.SelectColumns(#"Vue versement lue", {"compte_alias", "date_negociation", "nature", "montant", "annee", "periode"}),
				    // Montant en décimal fixe (Currency.Type, jamais un flottant), dates et année typées
				    #"Types fixés" = Table.TransformColumnTypes(#"Colonnes retenues", {{"compte_alias", type text}, {"date_negociation", type date}, {"nature", type text}, {"montant", Currency.Type}, {"annee", Int64.Type}, {"periode", type text}})
				in
				    #"Types fixés"

	annotation PBI_ResultType = Table

