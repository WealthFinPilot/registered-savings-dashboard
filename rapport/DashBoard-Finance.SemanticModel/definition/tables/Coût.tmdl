/// Coût de la stratégie au dernier point de chaque compte (vue rapport.cout, règle S6 de docs/regles-strategie.md) : VM, VM couverte par un profil, Σ VM × RFG, dates des profils appliqués.
table Coût
	lineageTag: 6832e5a4-1b12-41ce-81c2-3c908884adac

	column compte_alias
		dataType: string
		isHidden
		lineageTag: 07734541-4714-4ad8-8a29-c1b314565df5
		summarizeBy: none
		sourceColumn: compte_alias

	/// VM du compte au point (P2)
	column vm
		dataType: decimal
		isHidden
		formatString: #,##0 $
		lineageTag: c2527245-46ac-49e4-aa18-0fcc34da76f6
		summarizeBy: none
		sourceColumn: vm

	/// VM des fonds couverts par un profil (S1) : dénominateur du RFG pondéré
	column vm_profil
		dataType: decimal
		isHidden
		formatString: #,##0 $
		lineageTag: 340c80c8-e210-48be-bfbe-9ea078230937
		summarizeBy: none
		sourceColumn: vm_profil

	/// Σ VM × RFG des fonds couverts par un profil, en dollars, non arrondi
	column vm_rfg
		dataType: double
		isHidden
		lineageTag: afaba841-d5b4-4612-880e-2feffe9514e2
		summarizeBy: none
		sourceColumn: vm_rfg

	/// Plus ancienne date de données des profils appliqués au compte
	column premier_profil
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 989d1719-751d-4842-a142-cf8e68daac03
		summarizeBy: none
		sourceColumn: premier_profil

		annotation UnderlyingDateTimeDataType = Date

	/// Plus récente date de données des profils appliqués au compte
	column dernier_profil
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 30d26167-dd9f-4ebb-a0bc-12dfe6f66995
		summarizeBy: none
		sourceColumn: dernier_profil

		annotation UnderlyingDateTimeDataType = Date

	partition Coût = m
		mode: import
		source =
				let
				    // Vue rapport.cout : une ligne par compte et par point
				    #"Vue coût lue" =
				        // Figée : vue rapport.cout de finance_ve01, données fictives, 236 lignes (scripts/figer.py)
				        let
				            Lignes = Json.Document(Binary.Decompress(Binary.FromText(
				                "" &
				                "",
				                BinaryEncoding.Base64), Compression.Deflate)),
				            Brute = Table.FromRows(Lignes, {"compte_alias", "mois", "date_point", "dernier", "vm", "vm_profil", "vm_rfg", "premier_profil", "dernier_profil"}),
				            Dates = Table.TransformColumns(Brute, {{"mois", each Date.FromText(_, [Format = "yyyy-MM-dd", Culture = "en-US"]), type nullable date}, {"date_point", each Date.FromText(_, [Format = "yyyy-MM-dd", Culture = "en-US"]), type nullable date}, {"premier_profil", each Date.FromText(_, [Format = "yyyy-MM-dd", Culture = "en-US"]), type nullable date}, {"dernier_profil", each Date.FromText(_, [Format = "yyyy-MM-dd", Culture = "en-US"]), type nullable date}}),
				            Typée = Table.TransformColumnTypes(Dates, {{"compte_alias", type text}, {"dernier", type logical}, {"vm", type number}, {"vm_profil", type number}, {"vm_rfg", type number}})
				        in
				            Typée,
				    // Dernier point de chaque compte seulement, comme la table Exposition
				    #"Dernier point" = Table.SelectRows(#"Vue coût lue", each [dernier] = true),
				    // Colonnes du rapport seulement
				    #"Colonnes retenues" = Table.SelectColumns(#"Dernier point", {"compte_alias", "vm", "vm_profil", "vm_rfg", "premier_profil", "dernier_profil"}),
				    // VM en décimal fixe (au cent) ; Σ VM × RFG en nombre décimal ; dates sans heure
				    #"Types fixés" = Table.TransformColumnTypes(#"Colonnes retenues", {{"compte_alias", type text}, {"vm", Currency.Type}, {"vm_profil", Currency.Type}, {"vm_rfg", type number}, {"premier_profil", type date}, {"dernier_profil", type date}})
				in
				    #"Types fixés"

	annotation PBI_ResultType = Table

