/// Une cotisation REER par ligne, avec son année de déduction (vue rapport.mouvement) : exports et saisies hors export, y compris celles sans compte (autre institution). Table sans relation : seule la mesure REER cotisé cumulé la lit.
table 'Cotisation REER'
	isHidden
	lineageTag: e4afddd1-7c47-457d-ae0b-fad66cc81c3c

	/// Date de la cotisation
	column Date
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: b503f337-fd54-4a56-8806-d7564b6302f6
		summarizeBy: none
		sourceColumn: date_mouvement

		annotation UnderlyingDateTimeDataType = Date

	/// Année de déduction : les 60 premiers jours comptent pour l'année précédente
	column annee_droits
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: c2ee4047-26da-4e06-abc6-2e9b3d696d7c
		summarizeBy: none
		sourceColumn: annee_droits

	column montant
		dataType: decimal
		isHidden
		formatString: #,##0 $
		lineageTag: 439d0c47-ebed-4146-9848-40d73f1d2fcf
		summarizeBy: none
		sourceColumn: montant

	partition 'Cotisation REER' = m
		mode: import
		source =
				let
				    // Vue rapport.mouvement : cotisations et retraits, exports et saisies hors export, avec l'année de droits (REER : année de déduction, borne R6)
				    #"Vue mouvement lue" =
				        // Figée : vue rapport.mouvement de finance_ve01, données fictives, 593 lignes (scripts/figer.py)
				        let
				            Lignes = Json.Document(Binary.Decompress(Binary.FromText(
				                "" &
				                "ahRkhNUKmWC1fRWc7jH+dDXwmbz5TSkFeXNF5J7k98/w+DGJZ7Kiak+yKdW+f9jIlekEyN4mIV5O1CM4fRcrbDGpyLHrxbKV9kT2L8e3+WudqXExKS/J6cJQfvsqwyM5HRpoG5WO/v4/",
				                BinaryEncoding.Base64), Compression.Deflate)),
				            Brute = Table.FromRows(Lignes, {"regime", "compte_alias", "date_mouvement", "rang", "sens", "montant", "annee_droits"}),
				            Dates = Table.TransformColumns(Brute, {{"date_mouvement", each Date.FromText(_, [Format = "yyyy-MM-dd", Culture = "en-US"]), type nullable date}}),
				            Typée = Table.TransformColumnTypes(Dates, {{"regime", type text}, {"compte_alias", type text}, {"rang", Int64.Type}, {"sens", type text}, {"montant", type number}, {"annee_droits", Int64.Type}})
				        in
				            Typée,
				    // Cotisations REER seulement : le filtre est replié en WHERE dans PostgreSQL
				    #"Cotisations REER" = Table.SelectRows(#"Vue mouvement lue", each [regime] = "REER" and [sens] = "cotisation"),
				    // Colonnes utiles à la mesure seulement
				    #"Colonnes retenues" = Table.SelectColumns(#"Cotisations REER", {"date_mouvement", "annee_droits", "montant"}),
				    // Montant en décimal fixe (Currency.Type, jamais un flottant), date et année typées
				    #"Types fixés" = Table.TransformColumnTypes(#"Colonnes retenues", {{"date_mouvement", type date}, {"annee_droits", Int64.Type}, {"montant", Currency.Type}})
				in
				    #"Types fixés"

	annotation PBI_ResultType = Table

