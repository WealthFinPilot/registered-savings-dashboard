				                BinaryEncoding.Base64), Compression.Deflate)),
				            Brute = Table.FromRows(Lignes, {"risque", "ordre"}),
				            Typée = Table.TransformColumnTypes(Brute, {{"risque", type text}, {"ordre", Int64.Type}})
				        in
