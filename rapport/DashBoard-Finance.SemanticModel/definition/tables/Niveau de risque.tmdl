/// Niveaux de risque publiés, de Faible (1) à Élevé (5), plus « Non coté » (vue rapport.niveau_risque, règle S8) : axe des répartitions par niveau.
table 'Niveau de risque'
	lineageTag: cc73da2f-4550-423f-805a-bd4e238a67b5

	/// Niveau de risque publié par la Société 1 (méthode des ACVM), ou « Non coté » pour un fonds sans profil
	column 'Niveau de risque'
		dataType: string
		isKey
		lineageTag: c72b5d91-bbaa-4966-952e-336cf774f6c5
		summarizeBy: none
		sourceColumn: risque
		sortByColumn: ordre

	/// Rang du niveau (1 à 5), 9 pour « Non coté »
