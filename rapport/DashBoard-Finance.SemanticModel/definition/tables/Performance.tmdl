/// Un point de valorisation par compte et par mois (vue rapport.performance, règles P1 à P9 de docs/regles-performance.md) : VM, capital net, frais, numérateur et dénominateur de Dietz modifié. Comptes avec export seulement.
table Performance
	lineageTag: 431094fd-7357-4d22-a2f4-3147e9e5e774

	column compte_alias
		dataType: string
		isHidden
		lineageTag: 8df92799-42b5-46ac-b2c2-36f0c79e85e8
		summarizeBy: none
		sourceColumn: compte_alias

	/// Premier jour du mois du point de valorisation : clé vers Calendrier
	column mois
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: b9b12a95-e27b-408b-9e61-aa1d4a972e88
		summarizeBy: none
		sourceColumn: mois

		annotation UnderlyingDateTimeDataType = Date

	/// Date du point de valorisation (P1) : jour des frais de gestion ou date du Rapport
	column date_fin
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 72b8382d-9975-4def-9108-08dfec80e8b8
		summarizeBy: none
		sourceColumn: date_fin

		annotation UnderlyingDateTimeDataType = Date

	/// Valeur marchande au point (P2)
	column vm_fin
		dataType: decimal
		isHidden
		formatString: #,##0 $
		lineageTag: 18866200-7941-4e4e-a030-22b4722d6e9b
		summarizeBy: none
		sourceColumn: vm_fin

	/// Cumul des flux externes au point (P4)
	column capital_net
		dataType: decimal
		isHidden
		formatString: #,##0 $
		lineageTag: bf0e429d-20ce-4a9a-b8ef-916def91bfd7
		summarizeBy: none
		sourceColumn: capital_net

	/// Frais de gestion TTC et déductions sur achats de la sous-période (P9)
	column frais
		dataType: decimal
		isHidden
		formatString: #,##0 $
		lineageTag: be5ef071-a621-4bf5-a63a-94651f9c19f2
		summarizeBy: none
		sourceColumn: frais

	/// VM fin − VM début − flux (P6)
	column numerateur
		dataType: decimal
		isHidden
		lineageTag: 573fca95-055a-4760-ab1b-38de2e077049
		summarizeBy: none
		sourceColumn: numerateur

	/// VM début + flux pondérés (P6)
	column denominateur
		dataType: double
		isHidden
		lineageTag: c9a2a048-c29c-4555-bd7d-17988824d7d6
		summarizeBy: none
		sourceColumn: denominateur

	partition Performance = m
		mode: import
		source =
				let
				    // Vue rapport.performance : une ligne par compte et par mois, au point de valorisation du mois (P1)
				    #"Vue performance lue" =
				        // Figée : vue rapport.performance de finance_ve01, données fictives, 236 lignes (scripts/figer.py)
				        let
				            Lignes = Json.Document(Binary.Decompress(Binary.FromText(
				                "" &
				                "" &
				                "" &
				                "",
				                BinaryEncoding.Base64), Compression.Deflate)),
				            Brute = Table.FromRows(Lignes, {"compte_alias", "mois", "annee", "date_debut", "date_fin", "vm_debut", "vm_fin", "versements", "retraits", "flux", "frais", "distributions", "variation_prix", "capital_net", "gain_net", "numerateur", "denominateur", "rendement"}),
				            Dates = Table.TransformColumns(Brute, {{"mois", each Date.FromText(_, [Format = "yyyy-MM-dd", Culture = "en-US"]), type nullable date}, {"date_debut", each Date.FromText(_, [Format = "yyyy-MM-dd", Culture = "en-US"]), type nullable date}, {"date_fin", each Date.FromText(_, [Format = "yyyy-MM-dd", Culture = "en-US"]), type nullable date}}),
				            Typée = Table.TransformColumnTypes(Dates, {{"compte_alias", type text}, {"annee", Int64.Type}, {"vm_debut", type number}, {"vm_fin", type number}, {"versements", type number}, {"retraits", type number}, {"flux", type number}, {"frais", type number}, {"distributions", type number}, {"variation_prix", type number}, {"capital_net", type number}, {"gain_net", type number}, {"numerateur", type number}, {"denominateur", type number}, {"rendement", type number}})
				        in
				            Typée,
				    // Colonnes du rapport seulement : le régime et la société viennent de la table Compte
				    #"Colonnes retenues" = Table.SelectColumns(#"Vue performance lue", {"compte_alias", "mois", "date_fin", "vm_fin", "capital_net", "frais", "numerateur", "denominateur"}),
				    // Montants en décimal fixe (Currency.Type) ; dénominateur de Dietz en nombre décimal, car il porte des flux pondérés au-delà du centime
				    #"Types fixés" = Table.TransformColumnTypes(#"Colonnes retenues", {{"compte_alias", type text}, {"mois", type date}, {"date_fin", type date}, {"vm_fin", Currency.Type}, {"capital_net", Currency.Type}, {"frais", Currency.Type}, {"numerateur", Currency.Type}, {"denominateur", type number}})
				in
				    #"Types fixés"

