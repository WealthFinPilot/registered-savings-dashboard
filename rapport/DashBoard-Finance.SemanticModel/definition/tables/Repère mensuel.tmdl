				            Brute = Table.FromRows(Lignes, {"compte_alias", "mois", "code_fa", "poids", "rendement"}),
				            Dates = Table.TransformColumns(Brute, {{"mois", each Date.FromText(_, [Format = "yyyy-MM-dd", Culture = "en-US"]), type nullable date}}),
				            Typée = Table.TransformColumnTypes(Dates, {{"compte_alias", type text}, {"code_fa", type text}, {"poids", type number}, {"rendement", type number}})
